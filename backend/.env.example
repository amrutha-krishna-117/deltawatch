# ============================================================
# DeltaWatch Backend — Environment Configuration
# ============================================================
# Copy to .env and fill in your values.
# NEVER commit .env to source control.

# ── Market Data ──────────────────────────────────────────────
# "yahoo" = real Yahoo Finance data (requires internet, no API key)
# "sim"   = simulated feed (works offline, clearly labelled in UI)
MARKET_DATA_PROVIDER=yahoo

# ── Database ─────────────────────────────────────────────────
# Not set → SQLite (local file, zero config, good for 1 user / dev)
# postgres://... → PostgreSQL (handles concurrent users, survives scale-out)
#
# Free options:
#   Supabase: https://supabase.com (free tier, hosted Postgres)
#   Railway:  https://railway.app  (free tier, Postgres + Redis)
#   Neon:     https://neon.tech    (serverless Postgres, free tier)
#
# DATABASE_URL=postgresql://user:password@host:5432/deltawatch

# ── Redis (optional) ─────────────────────────────────────────
# Not set → in-memory pub/sub (single process only)
# redis://... → Redis pub/sub (enables multiple backend instances)
#
# Free options:
#   Upstash: https://upstash.com (serverless Redis, free tier)
#   Railway: https://railway.app (Redis plugin)
#
# REDIS_URL=redis://default:password@host:6379

# ── Server ───────────────────────────────────────────────────
PORT=4000
